<Window x:Class="ElectroCalc.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElectroCalc — Расчёт электрических цепей"
        Height="820" Width="1300"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SidePanel" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="Padding"         Value="10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ══ TOOLBAR ══════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PrimaryBrush}"
                Padding="8,6">
            <DockPanel>
                <TextBlock Text="⚡ ElectroCalc"
                           Foreground="White" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,20,0"/>

                <!-- Element shortcuts (informational) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="Добавить (2×клик на холсте):"
                               Foreground="#B0BEC5" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="R" ToolTip="Резистор"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnAddResistor_Click"  Width="28" Margin="2,0"/>
                    <Button Content="E" ToolTip="Источник ЭДС"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnAddESource_Click"   Width="28" Margin="2,0"/>
                    <Button Content="J" ToolTip="Источник тока"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnAddJSource_Click"   Width="28" Margin="2,0"/>
                    <Button Content="C" ToolTip="Конденсатор"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnAddCapacitor_Click" Width="28" Margin="2,0"/>
                    <Button Content="L" ToolTip="Индуктивность"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnAddInductor_Click"  Width="28" Margin="2,0"/>
                </StackPanel>

                <Separator Margin="4,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="Провод:" Foreground="#B0BEC5" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="тяни от ● порта элемента"
                               Foreground="#90CAF9" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Margin="4,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📂 Открыть схему"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnOpenCircuit_Click" Margin="2,0"/>
                    <Button Content="💾 Сохранить схему"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnSaveCircuit_Click" Margin="2,0"/>
                    <Separator Margin="4,0"/>
                    <Button Content="🗑 Удалить выбранное"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnDelete_Click" Margin="2,0"/>
                    <Button Content="Очистить"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnClearCanvas_Click" Margin="2,0"/>
                    <Button Content="📄 Экспорт Word"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnExportWord_Click" Margin="2,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ STATUS BAR ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="#E3F2FD"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="TxtStatus" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>

        <!-- ══ MAIN CONTENT ══════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"   MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="340" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL ──────────────────────────────────────────────── -->
            <DockPanel Grid.Column="0" Margin="4">

                <!-- Analysis mode -->
                <Border Style="{StaticResource SidePanel}" DockPanel.Dock="Top" Margin="4,4,4,2">
                    <StackPanel>
                        <TextBlock Text="РЕЖИМ ЦЕПИ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbDC" GroupName="AnalysisMode" Content="DC"
                                         IsChecked="True" Margin="0,3,16,3" FontSize="12"
                                         Checked="AnalysisMode_Changed"/>
                            <RadioButton x:Name="RbAC" GroupName="AnalysisMode" Content="AC"
                                         Margin="0,3,16,3" FontSize="12" Checked="AnalysisMode_Changed"/>
                            <RadioButton x:Name="RbThreePhase" GroupName="AnalysisMode" Content="3Φ"
                                         Margin="0,3" FontSize="12" Checked="AnalysisMode_Changed"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelFrequency" Visibility="Collapsed" Margin="0,5,0,0">
                            <TextBlock Text="Частота:" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="Гц" DockPanel.Dock="Right" FontSize="11"
                                           VerticalAlignment="Center" Margin="5,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtFrequency" Text="50" FontSize="12" Padding="4,3"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="TxtFrequency_TextChanged"/>
                            </DockPanel>
                            <TextBlock Text="Источники AC задаются действующим значением (RMS) и фазой; используется sin(ωt+φ)."
                                       FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Фазовая модель: x(t)=√2·X·sin(ωt+φ)."
                                       FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel x:Name="PanelThreePhase" Visibility="Collapsed" Margin="0,7,0,0">
                            <Button x:Name="BtnThreePhaseBuilder"
                                    Content="⚙ Настроить и построить 3Φ"
                                    Padding="6,4" Click="BtnThreePhaseBuilder_Click"/>
                            <TextBlock x:Name="TxtThreePhaseSummary"
                                       Text="Звезда с N; схема ещё не сформирована."
                                       FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Введите одну фазную ЭДС и сопротивления R+jX трёх ветвей — источники, элементы и проводники будут созданы автоматически."
                                       FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Calculation methods -->
                <Border Style="{StaticResource SidePanel}" DockPanel.Dock="Top" Margin="4,4,4,2">
                    <StackPanel>
                        <TextBlock Text="МЕТОД РАСЧЁТА" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RbMKT" GroupName="CalcMethod" Content="Контурные токи (МКТ)"
                                     IsChecked="True"  Margin="0,3" FontSize="12"/>
                        <RadioButton x:Name="RbKirchhoff" GroupName="CalcMethod" Content="Законы Кирхгофа"
                                     Margin="0,3" FontSize="12"/>
                        <RadioButton x:Name="RbMUP" GroupName="CalcMethod" Content="Узловые потенциалы (МУП)"
                                     Margin="0,3" FontSize="12"/>
                        <RadioButton x:Name="RbEqGen" GroupName="CalcMethod" Content="Эквив. генератор"
                                     Margin="0,3" FontSize="12"/>
                        <RadioButton x:Name="RbPotential" GroupName="CalcMethod" Content="Потенциальная диаграмма"
                                     Margin="0,3" FontSize="12"/>
                        <RadioButton x:Name="RbVector" GroupName="CalcMethod" Content="Данные для векторных диаграмм"
                                     Margin="0,3" FontSize="12"/>

                        <StackPanel x:Name="PanelLoadBranch" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock Text="Ветвь нагрузки:" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="CmbLoadBranch" Margin="0,3" FontSize="12"/>
                        </StackPanel>

                        <StackPanel x:Name="PanelContour" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock Text="Контур:" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="CmbContour" Margin="0,3" FontSize="11"
                                      MaxDropDownHeight="260"/>
                        </StackPanel>

                        <Border x:Name="PanelSimplifiedOffer" Visibility="Collapsed"
                                Margin="0,8,0,0" Padding="7" CornerRadius="4" Background="#E8F5E9">
                            <StackPanel>
                                <TextBlock Text="Доступен упрощённый расчёт" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtSimplifiedOffer" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,5"/>
                                <Button x:Name="BtnSimplifiedCalculate" Content="⚡ Рассчитать коротким способом"
                                        FontSize="10" Padding="5,3" Click="BtnSimplifiedCalculate_Click"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnCalculate" Content="▶  Рассчитать"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,10,0,0" Click="BtnCalculate_Click"/>
                    </StackPanel>
                </Border>

                <!-- Element properties -->
                <Border Style="{StaticResource SidePanel}" DockPanel.Dock="Top" Margin="4,2,4,2">
                    <StackPanel>
                        <TextBlock Text="СВОЙСТВА" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtSelectedElement"
                                   Text="Выберите элемент на схеме"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <StackPanel x:Name="PropPanel" Visibility="Collapsed">
                            <Button Content="↻ Повернуть на 90°"
                                    ToolTip="По часовой стрелке. На схеме: клавиша R"
                                    Margin="0,6,0,0" Padding="4,3"
                                    Click="BtnRotateElement_Click"/>
                            <TextBlock Text="Имя:" FontSize="11" Margin="0,6,0,2"/>
                            <TextBox x:Name="TxtPropName" FontSize="12" Padding="4,3"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="PropName_TextChanged"/>

                            <TextBlock x:Name="TxtPropValueLabel" Text="Значение:" FontSize="11" Margin="0,6,0,2"/>
                            <DockPanel>
                                <TextBlock x:Name="TxtPropUnit" Text="Ом"
                                           DockPanel.Dock="Right" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox x:Name="TxtPropValue" FontSize="12" Padding="4,3"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="PropValue_TextChanged"/>
                            </DockPanel>

                            <StackPanel x:Name="PropPhase" Visibility="Collapsed">
                                <TextBlock Text="Фаза, °:" FontSize="11" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtPropPhase" FontSize="12" Padding="4,3"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="PropPhase_TextChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PropThreePhasePhase" Visibility="Collapsed">
                                <TextBlock Text="Фаза / ветвь 3Φ:" FontSize="11" Margin="0,6,0,2"/>
                                <ComboBox x:Name="CmbPropThreePhasePhase" FontSize="11" Padding="3,2"
                                          SelectionChanged="PropThreePhasePhase_Changed">
                                    <ComboBoxItem Content="Не назначено" Tag="None"/>
                                    <ComboBoxItem Content="A (AN / AB)" Tag="A"/>
                                    <ComboBoxItem Content="B (BN / BC)" Tag="B"/>
                                    <ComboBoxItem Content="C (CN / CA)" Tag="C"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="PropInternalR" Visibility="Collapsed">
                                <TextBlock Text="Внутр. сопр. (Ом):" FontSize="11" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtPropInternalR" FontSize="12" Padding="4,3"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="PropInternalR_TextChanged"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkPolarity"
                                      Content="+ на порту A"
                                      Margin="0,8,0,0" FontSize="11"
                                      Visibility="Collapsed"
                                      Checked="ChkPolarity_Changed"
                                      Unchecked="ChkPolarity_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Node list -->
                <Border Style="{StaticResource SidePanel}" DockPanel.Dock="Top" Margin="4,2,4,4">
                    <StackPanel>
                        <TextBlock Text="УЗЛЫ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstNodes" FontSize="11"
                                 BorderThickness="0" MaxHeight="160"
                                 Background="Transparent"/>
                    </StackPanel>
                </Border>

                <Border/>
            </DockPanel>

            <!-- SPLITTER 1 -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- CANVAS ──────────────────────────────────────────────────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource CanvasBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Margin="0,4"
                    ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="CanvasScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="SchematicCanvas"
                                Width="1200" Height="900"
                                Background="{StaticResource CanvasBrush}"/>
                    </ScrollViewer>

                    <!-- Mode overlay -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#CC1565C0" CornerRadius="0,0,0,6" Padding="8,4">
                        <TextBlock x:Name="TxtMode"
                                   Text="Режим: Выбор"
                                   Foreground="White" FontSize="11"/>
                    </Border>

                    <!-- Help hint -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="#881565C0" CornerRadius="0,6,0,0" Padding="10,5">
                        <TextBlock Foreground="White" FontSize="10"
                                   Text="2×клик — добавить элемент  |  тяни от ● — провод  |  клик — выбрать"/>
                    </Border>
                </Grid>
            </Border>

            <!-- SPLITTER 2 -->
            <GridSplitter Grid.Column="3" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- RIGHT PANEL ─────────────────────────────────────────────── -->
            <DockPanel Grid.Column="4" Margin="4">
                <Border Style="{StaticResource SidePanel}" DockPanel.Dock="Top"
                        Margin="4" Padding="0" MaxHeight="340">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="5,5,0,0" Padding="12,8">
                            <TextBlock Text="ПОШАГОВОЕ РЕШЕНИЕ"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="LstSteps"
                                     BorderThickness="0" Background="Transparent"
                                     SelectionChanged="LstSteps_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Step detail -->
                <Border Style="{StaticResource SidePanel}" DockPanel.Dock="Top" Margin="4,2,4,4">
                    <StackPanel>
                        <TextBlock Text="ДЕТАЛИ ШАГА" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtStepDetail"
                                     IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap"
                                     Text="Выберите шаг в списке выше"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Results table -->
                <Border Style="{StaticResource SidePanel}" DockPanel.Dock="Top" Margin="4,0,4,4">
                    <StackPanel>
                        <TextBlock Text="РЕЗУЛЬТАТЫ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Button x:Name="BtnOpenVectorDiagrams"
                                Content="📐 Открыть векторные диаграммы"
                                Visibility="Collapsed" Margin="0,0,0,7" Padding="7,4"
                                Click="BtnOpenVectorDiagrams_Click"/>
                        <DataGrid x:Name="GridResults"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  FontSize="11" RowHeight="24" MaxHeight="180"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ветвь"  Binding="{Binding BranchName}" Width="80"/>
                                <DataGridTextColumn Header="I, А"   Binding="{Binding CurrentStr}"  Width="90"/>
                                <DataGridTextColumn Header="U, В"   Binding="{Binding VoltageStr}"  Width="90"/>
                                <DataGridTextColumn Header="P, Вт" Binding="{Binding ActivePowerStr}" Width="75"/>
                                <DataGridTextColumn Header="Q, вар" Binding="{Binding ReactivePowerStr}" Width="75"/>
                                <DataGridTextColumn Header="|S|, ВА" Binding="{Binding ApparentPowerStr}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="P,Q — знаковые мощности ветви по S=U·I*: + потребление; Q&gt;0 индуктивный характер, Q&lt;0 ёмкостный."
                                   FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Border x:Name="PowerBalanceBorder" Margin="0,8,0,0"
                                Padding="8,6" CornerRadius="4"
                                Background="#F5F7FA">
                            <StackPanel>
                                <TextBlock x:Name="TxtPowerGen"   Text="ΣS_ист = —" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtPowerCon"   Text="ΣS_потр = —" FontSize="11" Margin="0,2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtPowerDelta" Text="|ΔS| = —"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
