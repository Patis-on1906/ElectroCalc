<Window x:Class="ElectroCalc.UI.Views.ThreePhaseCalculationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Режим расчёта трёхфазной цепи"
        Width="510" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите состояние цепи перед расчётом"
                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="165"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Режим:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox x:Name="CmbOperatingMode" Grid.Row="0" Grid.Column="1" Margin="4" Padding="5,3"
                      SelectionChanged="Selection_Changed">
                <ComboBoxItem Content="Нормальный режим" Tag="Normal" IsSelected="True"/>
                <ComboBoxItem Content="Холостой ход (обрыв)" Tag="OpenCircuit"/>
                <ComboBoxItem Content="Короткое замыкание" Tag="ShortCircuit"/>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Место аварии:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox x:Name="CmbLocation" Grid.Row="1" Grid.Column="1" Margin="4" Padding="5,3"
                      DisplayMemberPath="Text"/>
        </Grid>

        <Border x:Name="PanelShortCircuit" Grid.Row="2" Margin="0,12,0,0" Padding="10"
                Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="5"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сопротивление места КЗ:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtFaultResistance" Grid.Column="1" Text="0.01" Margin="4" Padding="5,3"/>
                <TextBlock Grid.Column="2" Text="Ом" VerticalAlignment="Center" Margin="4"/>
            </Grid>
        </Border>

        <TextBlock x:Name="TxtHint" Grid.Row="3" Margin="2,14,2,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Отмена" Width="90" Padding="8,5"
                    IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Рассчитать" Width="125" Padding="8,5"
                    IsDefault="True" Click="BtnCalculate_Click"/>
        </DockPanel>
    </Grid>
</Window>
